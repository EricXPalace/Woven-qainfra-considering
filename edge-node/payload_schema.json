{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlackboxDumpPayload",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this kill switch / crash event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when the kill switch was triggered"
    },
    "trigger_reason": {
      "type": "string",
      "example": "KILL_SWITCH_ENGAGED"
    },
    "buffer_duration_seconds": {
      "type": "integer",
      "default": 60,
      "description": "Duration window of buffered telemetry"
    },
    "frame_count": {
      "type": "integer",
      "description": "Number of telemetry frames packaged in this dump"
    },
    "telemetry": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "speed_kmh": {
            "type": "number"
          },
          "brake_status": {
            "type": "boolean"
          },
          "brake_pressure_psi": {
            "type": "number"
          },
          "steering_angle_deg": {
            "type": "number"
          },
          "wheel_speed_rpm": {
            "type": "number"
          }
        },
        "required": [
          "timestamp",
          "speed_kmh",
          "brake_status",
          "brake_pressure_psi",
          "steering_angle_deg",
          "wheel_speed_rpm"
        ]
      }
    }
  },
  "required": [
    "event_id",
    "timestamp",
    "trigger_reason",
    "buffer_duration_seconds",
    "frame_count",
    "telemetry"
  ]
}
